    "check:interlinking": "python3 test/check-interlinking.py"
  },
  "devDependencies": {
    "@local-pdf-tools/core": "git+https://github.com/swtormy-agents/pdf-tools.git#f694cd4f6338f2d22004f31bfbd5577350e5a280",
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.50",

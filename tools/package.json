{
  "name": "local-pdf-tools-site-tools",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i css/input.css -o ../build/app.css --minify",
    "check:css": "node scripts/check-css.mjs",
    "build:js": "node scripts/build-js.mjs",
    "check:js": "node scripts/build-js.mjs --check",
    "test:worker": "node test/worker-tag.mjs",
